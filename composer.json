{
  "name": "tonsoo/filament-translatable",
  "description": "Simple translatable models and Filament form helpers for Laravel.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "illuminate/database": "^13.0",
    "illuminate/support": "^13.0",
    "filament/filament": "^5.0"
  },
  "require-dev": {
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^4.0",
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "psr-4": {
      "Tonsoo\\FilamentTranslatable\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tonsoo\\FilamentTranslatable\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Tonsoo\\FilamentTranslatable\\FilamentTranslatableServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "vendor/bin/pest"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
